APP_NAME=Text2SQL
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8090
APP_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=480
QUERY_MAX_ROWS=500
QUERY_MAX_ATTEMPTS=3

# OpenAI-compatible LLM settings
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
LLM_BASE_URL=
CLOUD_SUMMARIES_ENABLED=false
PII_REDACTION_ENABLED=true

# Application storage settings (implemented in later stages)
METADATA_DATABASE_URL=sqlite:///./data/text2sql.db
CHROMA_PERSIST_DIRECTORY=./data/chroma
